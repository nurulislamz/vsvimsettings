#!/usr/bin/env python3
"""Workmux dashboard grouped by worktree/session (prefix+a)."""

from __future__ import annotations

import curses
import json
import pathlib
import subprocess
import sys
import time


NATIVE = str(pathlib.Path.home() / ".local/libexec/workmux")


def run(argv: list[str], timeout: float = 4) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def load_agents() -> list[dict]:
    result = run([NATIVE, "status", "--all", "--json"])
    if result.returncode:
        return []
    try:
        payload = json.loads(result.stdout)
    except ValueError:
        return []
    agents = payload.get("agents")
    return agents if isinstance(agents, list) else []


def group_key(agent: dict) -> str:
    worktree = agent.get("worktree")
    if isinstance(worktree, str) and worktree.strip():
        return worktree.strip()
    session = agent.get("session")
    if isinstance(session, str) and session.strip():
        return session.strip()
    return "?"


def group_agents(agents: list[dict]) -> list[tuple[str, list[dict]]]:
    groups: dict[str, list[dict]] = {}
    order: list[str] = []
    for agent in agents:
        if not isinstance(agent, dict):
            continue
        key = group_key(agent)
        if key not in groups:
            order.append(key)
            groups[key] = []
        groups[key].append(agent)
    return [(key, groups[key]) for key in order]


def flatten(groups: list[tuple[str, list[dict]]]) -> list[tuple[str, dict | None]]:
    rows: list[tuple[str, dict | None]] = []
    for key, agents in groups:
        rows.append(("header", {"title": key, "count": len(agents)}))
        for agent in agents:
            rows.append(("agent", agent))
    return rows


def agent_label(agent: dict) -> str:
    title = agent.get("title") or agent.get("window_name") or agent.get("pane_id") or ""
    status = agent.get("status") or "-"
    return f"  {status:>1}  {title}"


def preview(pane_id: str) -> str:
    if not pane_id:
        return ""
    result = run(["tmux", "capture-pane", "-p", "-t", pane_id, "-S", "-40"], timeout=2)
    return result.stdout if result.returncode == 0 else ""


def jump(agent: dict) -> int:
    pane = agent.get("pane_id")
    session = agent.get("session")
    if not isinstance(pane, str) or not pane:
        return 1
    if isinstance(session, str) and session:
        run(["tmux", "switch-client", "-t", session], timeout=2)
    result = run(["tmux", "select-pane", "-t", pane], timeout=2)
    return result.returncode


def first_agent_index(rows: list[tuple[str, dict | None]]) -> int:
    for index, (kind, _) in enumerate(rows):
        if kind == "agent":
            return index
    return 0


def next_agent(rows: list[tuple[str, dict | None]], current: int, step: int) -> int:
    if not rows:
        return 0
    index = current
    for _ in range(len(rows)):
        index = (index + step) % len(rows)
        if rows[index][0] == "agent":
            return index
    return current


def draw(stdscr: curses.window, rows: list[tuple[str, dict | None]], selected: int, message: str) -> None:
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    split = max(8, height * 55 // 100)
    stdscr.addnstr(0, 0, "Workmux  agents by worktree    q quit  enter jump  r refresh", width - 1, curses.A_BOLD)
    y = 2
    for index, (kind, item) in enumerate(rows):
        if y >= split - 1:
            break
        if kind == "header":
            text = f"{item['title']}  ({item['count']})"
            stdscr.addnstr(y, 0, text[: width - 1], width - 1, curses.A_BOLD | curses.color_pair(2))
        else:
            attr = curses.A_REVERSE if index == selected else curses.A_NORMAL
            stdscr.addnstr(y, 0, agent_label(item)[: width - 1], width - 1, attr)
        y += 1
    stdscr.hline(split, 0, curses.ACS_HLINE, width)
    pane = ""
    if rows and rows[selected][0] == "agent":
        pane = str(rows[selected][1].get("pane_id") or "")
    body = preview(pane) if pane else message
    for offset, line in enumerate(body.splitlines()[: height - split - 2]):
        stdscr.addnstr(split + 1 + offset, 0, line[: width - 1], width - 1)
    stdscr.refresh()


def loop(stdscr: curses.window) -> int:
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(2, curses.COLOR_CYAN, -1)
    stdscr.nodelay(True)
    stdscr.timeout(250)
    selected = 0
    last_load = 0.0
    rows: list[tuple[str, dict | None]] = []
    message = ""
    while True:
        now = time.monotonic()
        if now - last_load > 2 or not rows:
            rows = flatten(group_agents(load_agents()))
            last_load = now
            if rows and rows[selected][0] != "agent":
                selected = first_agent_index(rows)
            elif selected >= len(rows):
                selected = first_agent_index(rows)
            message = "No registered agents." if not rows else ""
        draw(stdscr, rows, selected, message)
        key = stdscr.getch()
        if key in (ord("q"), 27):
            return 0
        if key in (ord("j"), curses.KEY_DOWN):
            selected = next_agent(rows, selected, 1)
        elif key in (ord("k"), curses.KEY_UP):
            selected = next_agent(rows, selected, -1)
        elif key in (ord("\n"), curses.KEY_ENTER, 10):
            if rows and rows[selected][0] == "agent":
                return jump(rows[selected][1])
        elif key == ord("r"):
            last_load = 0
        elif ord("1") <= key <= ord("9"):
            agents = [item for kind, item in rows if kind == "agent"]
            index = key - ord("1")
            if index < len(agents):
                return jump(agents[index])


def test_group_agents() -> None:
    groups = group_agents(
        [
            {"worktree": "improve-frontend-stuff", "title": "a1"},
            {"worktree": "review-backend", "title": "b1"},
            {"worktree": "improve-frontend-stuff", "title": "a2"},
            {"session": "orphan", "title": "c1"},
        ]
    )
    assert [key for key, _ in groups] == ["improve-frontend-stuff", "review-backend", "orphan"]
    assert [agent["title"] for agent in groups[0][1]] == ["a1", "a2"]
    rows = flatten(groups)
    assert rows[0][0] == "header"
    assert next_agent(rows, 0, 1) == 1
    assert next_agent(rows, 1, 1) == 2
    assert next_agent(rows, 2, 1) == 4


def main() -> int:
    if "--test" in sys.argv:
        test_group_agents()
        print("ok")
        return 0
    if not sys.stdout.isatty():
        print("Need a tty (tmux popup).", file=sys.stderr)
        return 2
    return curses.wrapper(loop)


if __name__ == "__main__":
    raise SystemExit(main())
