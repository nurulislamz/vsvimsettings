#!/usr/bin/env python3
"""Run workmux lifecycle hooks silently, using the Codex-box host relay."""

import json
import logging
import os
import pathlib
import socket
import subprocess
import sys

ACTION_ARGS = {
    "register": ["register-agent"],
    "working": ["set-window-status", "working"],
    "waiting": ["set-window-status", "waiting"],
    "done": ["set-window-status", "done"],
    "clear": ["set-window-status", "clear"],
}


def read_agy_prompt(path: str) -> str:
    transcript = pathlib.Path(path).expanduser().resolve()
    home = pathlib.Path.home()
    if not any(transcript.is_relative_to(root.resolve()) for root in (home / ".gemini/antigravity-cli/brain", home / ".agy-containers")):
        return ""
    if transcript.name != "transcript.jsonl":
        return ""
    try:
        with transcript.open("rb") as stream:
            stream.seek(max(0, transcript.stat().st_size - 262144))
            lines = stream.read(262144).splitlines()
        for line in reversed(lines):
            try:
                step = json.loads(line)
            except ValueError:
                continue
            if isinstance(step, dict) and step.get("type") == "USER_INPUT" and step.get("source") == "USER_EXPLICIT":
                content = step.get("content")
                return content[:300] if isinstance(content, str) else ""
    except OSError as error:
        logging.error("Cannot read AGY task title: %s", error)
    return ""


def read_hook_input() -> dict[str, str]:
    if sys.stdin.isatty():
        return {}
    try:
        raw = json.loads(sys.stdin.read(65536))
    except (ValueError, OSError):
        return {}
    if not isinstance(raw, dict):
        return {}
    result: dict[str, str] = {}
    for key in ("prompt", "initial_prompt", "initialPrompt", "session_id", "sessionId", "agent_id", "subagentType", "background_working", "hook_event_name"):
        value = raw.get(key)
        if isinstance(value, str):
            result[key] = value[:300] if key in ("prompt", "initial_prompt", "initialPrompt") else value[:128]
    if isinstance(raw.get("conversationId"), str):
        result["session_id"] = raw["conversationId"][:128]
        path = raw.get("transcriptPath")
        if isinstance(path, str):
            result["prompt"] = read_agy_prompt(path)
    if raw.get("fullyIdle") is False:
        result["background_working"] = "true"
    return result


def tmux(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=2, check=False)


def reload_tab_theme_once() -> None:
    loaded = tmux(["show-option", "-gqv", "@workmux_colour_theme_loaded"])
    if loaded.stdout.strip() == "1":
        return
    config = pathlib.Path.home() / ".tmux.conf"
    if not config.is_file():
        return
    result = tmux(["source-file", str(config)])
    if result.returncode:
        logging.error("Cannot reload tmux theme: %s", result.stderr.strip()[:300])
        return
    tmux(["set-option", "-g", "@workmux_colour_theme_loaded", "1"])


def apply_host_event(action: str, payload: dict[str, str], pane: str, window: str) -> int:
    current = tmux(["display-message", "-p", "-t", pane, "#{window_id}"])
    if current.returncode or current.stdout.strip() != window:
        return 0
    if action == "register":
        reload_tab_theme_once()
    colour = "blocked" if action == "waiting" else "working" if action in ("register", "clear") else action

    env = os.environ.copy()
    env["TMUX_PANE"] = pane
    env["WORKMUX_STATUS_BACKEND"] = "tmux"
    env["WORKMUX_STATUS_INSTANCE"] = env.get("TMUX", "").split(",")[0]
    env["WORKMUX_STATUS_PANE_ID"] = pane
    if not env["WORKMUX_STATUS_INSTANCE"]:
        env["WORKMUX_STATUS_INSTANCE"] = "/tmp/tmux-" + str(os.getuid()) + "/default"
    binary = pathlib.Path.home() / ".local/libexec/workmux"
    result = subprocess.run(
        [str(binary), *ACTION_ARGS[action]],
        input=json.dumps(payload), capture_output=True, text=True, env=env, timeout=3, check=False,
    )
    if result.returncode:
        logging.error("Workmux %s failed: %s", action, result.stderr.strip()[:300])
        return result.returncode
    tmux(["set-option", "-w", "-t", window, "@agent_status", colour])
    return 0


def send_relay_event(path: str, action: str, payload: dict[str, str]) -> int:
    request = {"action": action, "input": payload}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(4)
        client.connect(path)
        client.sendall(("@workmux " + json.dumps(request, ensure_ascii=False) + "\n").encode())
        return 0 if client.recv(4096).startswith(b"OK") else 1


def main() -> int:
    if "WORKMUX_DISABLE_SET_WINDOW_STATUS" in os.environ:
        return 0
    args = sys.argv[1:]
    payload = read_hook_input()
    if len(args) == 4 and args[0] == "--host":
        _, action, pane, window = args
        if action not in ACTION_ARGS or not pane.startswith("%") or not window.startswith("@"):
            return 2
        return apply_host_event(action, payload, pane, window)
    if args == ["register-agent"]:
        action = "register"
    elif len(args) == 2 and args[0] == "set-window-status" and args[1] in ACTION_ARGS:
        action = args[1]
    else:
        return 2
    if (
        action == "done"
        and payload.get("background_working") == "true"
        and payload.get("hook_event_name") != "Stop"
    ):
        action = "working"
    relay = os.environ.get("CODEX_BOX_RENAME_SOCKET", "")
    if relay:
        try:
            if send_relay_event(relay, action, payload) == 0:
                return 0
        except OSError:
            pass
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return 0
    current = tmux(["display-message", "-p", "-t", pane, "#{window_id}"])
    if current.returncode:
        return 0
    return apply_host_event(action, payload, pane, current.stdout.strip())


if __name__ == "__main__":
    try:
        log_dir = pathlib.Path.home() / ".local/state/workmux"
        log_dir.mkdir(parents=True, exist_ok=True)
        logging.basicConfig(filename=str(log_dir / "hooks.log"), level=logging.ERROR)
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        logging.error("Workmux hook failed: %s", error)
        raise SystemExit(0)
