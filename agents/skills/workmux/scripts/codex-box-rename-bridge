#!/usr/bin/env python3
"""Accept only Workmux lifecycle events for the launching tmux window."""

import json
import os
import pathlib
import socketserver
import subprocess
import sys


def socket_path_allowed(socket_path: str) -> bool:
    path = pathlib.Path(socket_path)
    if not path.name.startswith("codex-box-rename-") or not path.name.endswith(".sock"):
        return False
    parent = path.parent.resolve()
    if parent == pathlib.Path("/tmp"):
        return True
    root = (pathlib.Path.home() / ".codex-containers").resolve()
    return parent.name == "tmp" and parent.is_relative_to(root)


def main() -> int:
    if len(sys.argv) != 4:
        return 2
    socket_path, window, pane = sys.argv[1:]
    if not socket_path_allowed(socket_path):
        return 2
    if not window.removeprefix("@").isdigit() or not pane.removeprefix("%").isdigit():
        return 2
    if not window.startswith("@") or not pane.startswith("%") or os.path.lexists(socket_path):
        return 2
    default = subprocess.run(
        ["tmux", "set-option", "-w", "-t", window, "@agent_status", "working"],
        capture_output=True, timeout=2, check=False,
    )
    if default.returncode:
        return 1
    subprocess.run(
        [str(pathlib.Path.home() / ".local/bin/workmux-agent-hook"), "--host", "working", pane, window],
        input="{}", capture_output=True, text=True, timeout=12, check=False,
    )

    class Handler(socketserver.StreamRequestHandler):
        def handle(self) -> None:
            self.connection.settimeout(5)
            try:
                request = self.rfile.readline(8193)
                if len(request) > 8192 or not request.endswith(b"\n") or not request.startswith(b"@workmux "):
                    self.wfile.write(b"ERR invalid request\n")
                    return
                event = json.loads(request[9:])
                if not isinstance(event, dict) or event.get("action") not in ("register", "working", "waiting", "done", "clear"):
                    self.wfile.write(b"ERR invalid action\n")
                    return
                payload = event.get("input")
                allowed_keys = {"prompt", "initial_prompt", "initialPrompt", "session_id", "sessionId", "agent_id", "subagentType", "background_working", "hook_event_name"}
                if not isinstance(payload, dict) or not all(key in allowed_keys and isinstance(value, str) for key, value in payload.items()):
                    self.wfile.write(b"ERR invalid input\n")
                    return
                result = subprocess.run(
                    [str(pathlib.Path.home() / ".local/bin/workmux-agent-hook"), "--host", event["action"], pane, window],
                    input=json.dumps(payload), capture_output=True, text=True, timeout=12, check=False,
                )
                self.wfile.write(b"OK\n" if result.returncode == 0 else b"ERR Workmux update failed\n")
            except (OSError, ValueError, subprocess.SubprocessError):
                self.wfile.write(b"ERR relay update failed\n")

    # A serial server preserves lifecycle event order for this agent.
    with socketserver.UnixStreamServer(socket_path, Handler) as server:
        os.chmod(socket_path, 0o600)
        try:
            server.serve_forever(poll_interval=0.2)
        finally:
            pathlib.Path(socket_path).unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
