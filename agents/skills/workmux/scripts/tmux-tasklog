#!/usr/bin/env bash
set -euo pipefail

# Resolve the session/worktree task.md. Agents must call: TASK_FILE=$(tmux-tasklog path)
OLD_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux/tasklogs"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/workmux/tasklogs"

action="${1:-open}"
session="${2:-$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null || true)}"
if [ -z "$session" ]; then
  session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
fi
session="${session:-default}"
worktree="${3:-}"
if [ -z "$worktree" ] && [ "$action" != init ]; then
  worktree=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_current_path}' 2>/dev/null || true)
  if [ -z "$worktree" ]; then
    worktree=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null || true)
  fi
fi
worktree=$(cd "${worktree:-$PWD}" && pwd)
safe_session="$(printf '%s' "$session" | tr -d "\"'" | tr ' /' '_')"

is_workmux_tree() {
  local root="$1"
  case "$root" in
    */.worktrees/*) return 0 ;;
  esac
  local branch
  branch=$(git -C "$root" branch --show-current 2>/dev/null || true)
  [ -n "$branch" ] && git -C "$root" config --local --get "branch.${branch}.workmux-base" >/dev/null 2>&1
}

resolve() {
  local gitroot
  gitroot=$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null || true)
  gitroot="${gitroot:-$worktree}"
  if is_workmux_tree "$gitroot"; then
    mkdir -p "$gitroot/.workmux"
    printf '%s\n' "$gitroot/.workmux/task.md"
    return
  fi
  mkdir -p "$STATE/$safe_session"
  printf '%s\n' "$STATE/$safe_session/task.md"
}

write_template() {
  local dest="$1"
  local branch
  branch=$(git -C "$worktree" branch --show-current 2>/dev/null || true)
  branch="${branch:-none}"
  cat > "$dest" <<EOF
# Session: $session
Worktree: $worktree
Branch: $branch
Created: $(date '+%Y-%m-%d %H:%M')

## Tasks

## Notes
EOF
}

migrate_old() {
  local dest="$1"
  local old="$OLD_DIR/${safe_session}.md"
  if [ ! -f "$dest" ] && [ -f "$old" ]; then
    mkdir -p "$(dirname "$dest")"
    cp "$old" "$dest"
  fi
}

init_file() {
  dest="$(resolve)"
  migrate_old "$dest"
  tmux set-environment -r -t "$session" TASK_FILE 2>/dev/null || true
  if [ ! -f "$dest" ]; then
    write_template "$dest"
  fi
}

self_check() {
  local tmp repo wt out script
  script=$(realpath "$0")
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  repo="$tmp/repo"
  mkdir -p "$repo"
  git -C "$repo" init -b main >/dev/null
  git -C "$repo" config user.email e2e@localhost
  git -C "$repo" config user.name E2E
  out=$(XDG_STATE_HOME="$tmp/state" "$0" path sess "$repo")
  [ "$out" = "$tmp/state/workmux/tasklogs/sess/task.md" ] || {
    echo "FAIL session fallback: $out" >&2
    exit 1
  }
  [ -f "$out" ] || { echo "FAIL missing session task.md" >&2; exit 1; }
  wt="$tmp/proj/.worktrees/feat"
  mkdir -p "$wt"
  git -C "$wt" init -b main >/dev/null
  out=$(XDG_STATE_HOME="$tmp/state" "$0" path wm-feat "$wt")
  [ "$out" = "$wt/.workmux/task.md" ] || {
    echo "FAIL worktree path: $out" >&2
    exit 1
  }
  [ -f "$out" ] || { echo "FAIL missing worktree task.md" >&2; exit 1; }
  git -C "$repo" config branch.other.workmux-base main
  out=$(XDG_STATE_HOME="$tmp/state" "$0" path sess "$repo")
  [ "$out" = "$tmp/state/workmux/tasklogs/sess/task.md" ]
  git -C "$repo" config branch.main.workmux-base main
  out=$(XDG_STATE_HOME="$tmp/state" "$0" path sess "$repo")
  [ "$out" = "$repo/.workmux/task.md" ]
  mkdir -p "$tmp/bin"
  printf '#!/bin/sh\nexit 0\n' > "$tmp/bin/tmux"
  chmod +x "$tmp/bin/tmux"
  out=$(cd "$wt" && PATH="$tmp/bin:$PATH" XDG_STATE_HOME="$tmp/state" "$script" path)
  [ "$out" = "$wt/.workmux/task.md" ]
  printf '#!/bin/sh\ncase "$1" in display-message) printf ignored ;; esac\n' > "$tmp/bin/tmux"
  rm "$wt/.workmux/task.md"
  out=$(cd "$wt" && PATH="$tmp/bin:$PATH" XDG_STATE_HOME="$tmp/state" "$script" init)
  [ -z "$out" ] && [ -f "$wt/.workmux/task.md" ]
  echo "PASS tmux-tasklog self-check"
}

case "$action" in
  init)
    init_file
    ;;
  path)
    init_file
    printf '%s\n' "$dest"
    ;;
  open)
    init_file
    exec "${EDITOR:-nvim}" "$dest"
    ;;
  --self-check)
    self_check
    ;;
  *)
    echo "Usage: $0 {init|open|path|--self-check} [session] [worktree]" >&2
    exit 1
    ;;
esac
