{
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "ui_font_size": 15,
  "tab_size": 4,
  "hard_tabs": false,
  "relative_line_numbers": "enabled",
  "current_line_highlight": "all",
  "cursor_blink": false,
  "which_key": {
    "enabled": true,
    "delay_ms": 200
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "minimap": {
    "show": "always"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Ayu Dark"
  },
  "icon_theme": "Zed (Default)",
  "git": {
    "diff_base": "head",
    "inline_blame": {
      "enabled": true
    }
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true
  },
  "diff_view_style": "split",
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on"
    },
    "Go": {
      "language_servers": ["gopls"],
      "format_on_save": "on"
    },
    "CSharp": {
      "language_servers": ["roslyn"],
      "format_on_save": "on",
      "tab_size": 4
    },
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on"
    },
    "Lua": {
      "language_servers": ["lua-language-server"],
      "format_on_save": "on"
    },
    "Markdown": {
      "soft_wrap": "none",
      "format_on_save": "off"
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    }
  }
}
